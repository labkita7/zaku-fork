meta {
  name: Authorize Calendar
  type: http
  seq: 15
}

get {
  url: https://api.example.com/calendar
  auth: oauth2
}

auth:oauth2 {
  grant_type: authorization_code
  callback_url: http://localhost:8080/api/auth/oauth2/authorization_code/callback
  authorization_url: https://api.example.com/oauth2/authorize
  access_token_url: https://api.example.com/oauth2/token
  refresh_token_url: https://api.example.com/oauth2/refresh
  client_id: test-client-id
  client_secret: __REDACTED_TEST_SECRET__
  scope: calendar.read
  state: 807061d5f0be
  pkce: false
  credentials_placement: body
  credentials_id: credentials
  token_source: access_token
  token_placement: header
  token_header_prefix: Bearer
  auto_fetch_token: true
  auto_refresh_token: true
}
